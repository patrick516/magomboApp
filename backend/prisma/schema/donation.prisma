enum DonationCategory {
  TITHE
  OFFERING
  BUILDING_FUND
  MISSIONS
  THANKSGIVING
  OTHER
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

model Donation {
  id        String           @id @default(uuid())
  amount    Decimal          @db.Decimal(12, 2)
  category  DonationCategory
  method    String
  status    DonationStatus   @default(PENDING)
  reference String?
  createdAt DateTime         @default(now()) @map("created_at")

  @@map("donations")
}
