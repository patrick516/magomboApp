model SmallGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  meetingDay  String?  @map("meeting_day")
  meetingTime String?  @map("meeting_time")
  location    String?
  leaderName  String?  @map("leader_name")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("small_groups")
}
