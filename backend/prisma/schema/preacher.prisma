enum PreacherStatus {
  PENDING
  APPROVED
  REJECTED
}

model Preacher {
  id        String         @id @default(uuid())
  deviceId  String         @map("device_id")
  name      String
  position  String?
  status    PreacherStatus @default(PENDING)
  createdAt DateTime       @default(now()) @map("created_at")

  sermons Sermon[]

  @@map("preachers")
}